{
  "name": "n8n-nodes-mintpdf",
  "version": "0.1.1",
  "description": "n8n community node for MintPDF: convert HTML, Markdown or a URL to PDF",
  "license": "MIT",
  "homepage": "https://mintpdf.dev",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "pdf",
    "html-to-pdf",
    "markdown-to-pdf",
    "url-to-pdf",
    "mintpdf"
  ],
  "author": {
    "name": "Peter Hallander",
    "email": "kartaginy1@gmail.com",
    "url": "https://mintpdf.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TrendTweekers/n8n-nodes-mintpdf.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/MintPdfApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/MintPdf/MintPdf.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.50.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/TrendTweekers/n8n-nodes-mintpdf/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
